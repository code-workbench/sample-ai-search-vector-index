# Azure AI Search Infrastructure Configuration
# Copy this file to .env and update with your specific values

# Resource Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_RESOURCE_GROUP=rg-aisearch-private
AZURE_LOCATION=eastus

# Project Configuration
PROJECT_NAME=aisearch-private
ENVIRONMENT=dev

# Network Configuration
VNET_ADDRESS_SPACE=10.0.0.0/16
SEARCH_SUBNET_PREFIX=10.0.1.0/24
PRIVATE_ENDPOINT_SUBNET_PREFIX=10.0.2.0/24

# Service Configuration
SEARCH_SERVICE_SKU=standard
STORAGE_ACCOUNT_SKU=Standard_LRS

# Monitoring
LOG_ANALYTICS_RETENTION_DAYS=30

# Tags
COST_CENTER=development
OWNER=dev-team
PROJECT_TAG=ai-search-vector-index
